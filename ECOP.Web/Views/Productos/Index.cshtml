@model IEnumerable<ProductoViewModels>
@{ ViewData["Title"] = "Productos"; }

<style>
    tr.fila-inactiva td {
        text-decoration: line-through !important;
        color: #adb5bd !important;
    }

    .disabled {
        pointer-events: none;
        opacity: 0.5;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-box me-2"></i>Productos</h2>
    <a asp-action="Crear" class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i>Nuevo Producto
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-success">
                <tr>
                    <th>Código</th>
                    <th>Descripción</th>
                    <th>Unidad</th>
                    <th class="text-end">Precio</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr class="@(!p.Activo ? "fila-inactiva" : "")">
                        <td><span class="badge @(!p.Activo ? "bg-secondary" : "bg-info")">@p.Codigo</span></td>
                        <td>@p.Descripcion</td>
                        <td>@p.UnidadMedida</td>
                        <td class="text-end">@p.PrecioUnitario.ToString("N2")</td>
                        <td class="text-end">
                            @if (p.Stock <= 10)
                            {
                                <span class="badge bg-danger">@p.Stock</span>
                            }
                            else
                            {
                                <span>@p.Stock</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Editar" asp-route-id="@p.Id" class="btn btn-sm btn-outline-warning me-1" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Eliminar" asp-route-id="@p.Id" method="post" class="d-inline @(!p.Activo ? "disabled" : "")"
                                  onsubmit="return confirm('¿Eliminar el producto @p.Codigo?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No hay productos registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
