@model ClienteViewModel
@{ ViewData["Title"] = "Detalle de Cliente"; }

<div class="d-flex align-items-center mb-3 gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h2 class="mb-0"><i class="bi bi-person me-2"></i>@Model.NombreCompleto</h2>
</div>

<div class="card shadow-sm" style="max-width:600px">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Tipo Documento</dt>
            <dd class="col-sm-8">@Model.TipoDocumento</dd>
            <dt class="col-sm-4">Nro. Documento</dt>
            <dd class="col-sm-8">@Model.NroDocumento</dd>
            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@(Model.Email ?? "-")</dd>
            <dt class="col-sm-4">Teléfono</dt>
            <dd class="col-sm-8">@(Model.Telefono ?? "-")</dd>
            <dt class="col-sm-4">Fecha Alta</dt>
            <dd class="col-sm-8">@Model.FechaAlta.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">
                @if (Model.Activo)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactivo</span>
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer d-flex gap-2">
        <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
            <i class="bi bi-pencil me-1"></i>Editar
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver</a>
    </div>
</div>
