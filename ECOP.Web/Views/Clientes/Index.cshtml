@model IEnumerable<ClienteViewModel>
@{ ViewData["Title"] = "Clientes"; }

<style>
    tr.fila-inactiva td {
        text-decoration: line-through !important;
        color: #adb5bd !important;
    }

    .disabled {
        pointer-events: none;
        opacity: 0.5;
    }
</style>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-people me-2"></i>Clientes</h2>
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Nuevo Cliente
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-primary">
                <tr>
                    <th>Nombre completo</th>
                    <th>Tipo Doc.</th>
                    <th>Nro. Documento</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Fecha Alta</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr class="@(!c.Activo ? "fila-inactiva" : "")">
                        <td class="fw-semibold">@c.NombreCompleto</td>
                        <td>@c.TipoDocumento</td>
                        <td>@c.NroDocumento</td>
                        <td>@(c.Email ?? "-")</td>
                        <td>@(c.Telefono ?? "-")</td>
                        <td>@c.FechaAlta.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Detalle" asp-route-id="@c.Id" class="btn btn-sm btn-outline-info me-1" title="Ver detalle">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Editar" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning me-1" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Eliminar" asp-route-id="@c.Id" method="post" class="d-inline @(!c.Activo ? "disabled" : "")"
                                  onsubmit="return confirm('¿Eliminar al cliente @c.NombreCompleto?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No hay clientes registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
