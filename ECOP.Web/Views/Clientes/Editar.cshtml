@model ClienteFormViewModel
@{
    ViewData["Title"] = "Editar Cliente";
}
<div class="d-flex align-items-center mb-3 gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h2 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Editar Cliente</h2>
</div>
<div class="card shadow-sm" style="max-width:600px">
    <div class="card-body">
        <form asp-action="Editar" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <partial name="_Form" model="Model" />
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-save me-1"></i>Actualizar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>

        <form asp-action="CambiarActivo" asp-route-id="@Model.Id" method="post" class="mt-2">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-success @(Model.Activo ? "d-none": "") ">
                <i class="bi @(Model.Activo ? "bi-toggle-on" : "bi-toggle-off") me-1"></i>
                Activar
            </button>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="~/Views/Shared/_ValidationScripts.cshtml" />
}