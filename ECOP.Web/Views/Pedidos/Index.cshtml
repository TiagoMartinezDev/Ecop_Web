@model IEnumerable<PedidoListaViewModel>
@{ ViewData["Title"] = "Pedidos"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-receipt me-2"></i>Pedidos</h2>
    <a asp-action="Crear" class="btn btn-warning">
        <i class="bi bi-plus-circle me-1"></i>Nuevo Pedido
    </a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Cliente</label>
                <select name="clienteId" asp-items="ViewBag.Clientes" class="form-select form-select-sm">
                    <option value="">Todos los clientes</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Estado</label>
                <select name="estado" asp-items="ViewBag.Estados" class="form-select form-select-sm">
                    <option value="">Todos los estados</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary btn-sm me-1">
                    <i class="bi bi-search me-1"></i>Filtrar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-warning">
                <tr>
                    <th>N° Pedido</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th class="text-end">Total Gs.</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-semibold font-monospace">@p.NumeroPedido</td>
                        <td>@p.Cliente</td>
                        <td>@p.FechaPedido.ToString("dd/MM/yyyy")</td>
                        <td>
                            @{
                                var badge = p.Estado switch
                                {
                                    "Pendiente"  => "bg-secondary",
                                    "Confirmado" => "bg-info",
                                    "En Proceso" => "bg-primary",
                                    "Despachado" => "bg-warning text-dark",
                                    "Entregado"  => "bg-success",
                                    "Cancelado"  => "bg-danger",
                                    _            => "bg-secondary"
                                };
                            }
                            <span class="badge @badge">@p.Estado</span>
                        </td>
                        <td class="text-end">@p.TotalMonto.ToString("N0")</td>
                        <td class="text-end">
                            <a asp-action="Detalle" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info me-1" title="Ver detalle">
                                <i class="bi bi-eye"></i>
                            </a>
                            @if (p.Estado != "Cancelado" && p.Estado != "Entregado")
                            {
                                <a asp-action="Editar" asp-route-id="@p.Id" class="btn btn-sm btn-outline-warning me-1" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            }
                            <a asp-action="CambiarEstado" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary me-1" title="Cambiar estado">
                                <i class="bi bi-arrow-left-right"></i>
                            </a>
                            @if (p.Estado != "Cancelado" && p.Estado != "Entregado")
                            {
                                <form asp-action="Cancelar" asp-route-id="@p.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Cancelar el pedido @p.NumeroPedido?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancelar">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No hay pedidos registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
