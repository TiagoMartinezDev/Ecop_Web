@model CambiarEstadoViewModel
@{ ViewData["Title"] = "Cambiar Estado"; }

<div class="d-flex align-items-center mb-3 gap-2">
    <a asp-action="Detalle" asp-route-id="@Model.PedidoId" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h2 class="mb-0"><i class="bi bi-arrow-left-right me-2"></i>Cambiar Estado del Pedido</h2>
</div>

<div class="card shadow-sm" style="max-width:400px">
    <div class="card-header">
        Pedido <span class="font-monospace fw-semibold">@Model.NumeroPedido</span>
    </div>
    <div class="card-body">
        <form asp-action="CambiarEstado" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PedidoId" />
            <input type="hidden" asp-for="NumeroPedido" />
            <div class="mb-3">
                <label asp-for="EstadoId" class="form-label fw-semibold">Nuevo Estado</label>
                <select asp-for="EstadoId" asp-items="Model.Estados" class="form-select"></select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i>Guardar
                </button>
                <a asp-action="Detalle" asp-route-id="@Model.PedidoId" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
